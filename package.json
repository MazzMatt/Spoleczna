{
  "name": "spoleczna-chelm",
  "version": "1.0.0",
  "type": "module",
  "description": "Pierwsza Społeczna Szkoła Podstawowa w Chełmie - zintegrowana z Neon Lakebase Postgres",
  "scripts": {
    "build": "node scripts/sync-gallery.js && node scripts/build.js",
    "sync": "node scripts/sync-gallery.js",
    "publish": "node scripts/sync-gallery.js && git add data/galerie.json && git commit -m 'Aktualizacja galerii na GitHub Pages' && git push",
    "start": "node server.js",
    "dev": "node server.js",
    "test": "node scripts/test-db.js && node scripts/test-server.js",
    "test:db": "node scripts/test-db.js",
    "test:server": "node scripts/test-server.js"
  },
  "dependencies": {
    "@neon/config": "^1.11.3",
    "@neon/env": "^1.6.15",
    "@neondatabase/serverless": "^1.2.0",
    "@pdf-lib/fontkit": "^1.1.1",
    "cloudinary": "^2.11.0",
    "docx": "^9.15.3",
    "dotenv": "^18.0.9",
    "express": "^5.3.0",
    "pdf-lib": "^1.17.1"
  }
}
